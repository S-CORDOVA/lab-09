<h1><%= @pet.name %></h1>

<% if @pet.photo.attached? %>
  <%= image_tag @pet.photo, width: 300, class: "img-fluid rounded mb-3" %>
<% else %>
  <div class="bg-light border rounded p-4 mb-3 text-muted text-center" style="max-width: 300px;">
    No photo available
  </div>
<% end %>

<p>Species: <%= @pet.species %></p>
<p>Breed: <%= @pet.breed %></p>
<p>Date of birth: <%= formatted_date(@pet.date_of_birth) %></p>
<p>Weight: <%= @pet.weight %></p>

<p>
  Owner:
  <%= link_to "#{@pet.owner.first_name} #{@pet.owner.last_name}", owner_path(@pet.owner) %>
</p>

<h2>Appointments</h2>

<ul>
  <% @pet.appointments.each do |appointment| %>
    <% if policy(appointment).show? %>
      <li>
        <%= link_to "#{formatted_datetime(appointment.date)} - #{appointment.reason}", appointment_path(appointment) %>
      </li>
    <% end %>
  <% end %>
</ul>

<div class="d-flex gap-2 mt-3">
  <%= link_to "Back", pets_path, class: "btn btn-outline-secondary" %>

  <% if policy(@pet).edit? %>
    <%= link_to "Edit", edit_pet_path(@pet), class: "btn btn-secondary" %>
  <% end %>

  <% if policy(@pet).destroy? %>
    <%= button_to "Delete",
        @pet,
        method: :delete,
        form: { data: { turbo_confirm: "Are you sure?" } },
        class: "btn btn-danger" %>
  <% end %>
</div>