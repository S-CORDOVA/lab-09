<nav class="navbar navbar-dark bg-dark">
  <div class="container">
    <%= link_to "VetClinic", root_path, class: "navbar-brand" %>

    <div class="d-flex gap-2 align-items-center">
      <% if user_signed_in? %>
        <% if current_user.owner? && current_user.owner.present? %>
          <%= link_to "My account", owner_path(current_user.owner), class: "btn btn-outline-light btn-sm" %>
        <% elsif policy(Owner).index? %>
          <%= link_to "Owners", owners_path, class: "btn btn-outline-light btn-sm" %>
        <% end %>

        <% if policy(Pet).index? %>
          <%= link_to "Pets", pets_path, class: "btn btn-outline-light btn-sm" %>
        <% end %>

        <% if policy(Vet).index? %>
          <%= link_to "Vets", vets_path, class: "btn btn-outline-light btn-sm" %>
        <% end %>

        <% if policy(Appointment).index? %>
          <%= link_to "Appointments", appointments_path, class: "btn btn-outline-light btn-sm" %>
        <% end %>

        <span class="text-light ms-3">
          <%= current_user.first_name %> <%= current_user.last_name %>
        </span>

        <%= button_to "Sign out",
            destroy_user_session_path,
            method: :delete,
            class: "btn btn-outline-warning btn-sm" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "btn btn-outline-light btn-sm" %>
      <% end %>
    </div>
  </div>
</nav>