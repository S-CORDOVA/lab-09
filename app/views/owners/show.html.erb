<h1><%= @owner.first_name %> <%= @owner.last_name %></h1>

<p>Email: <%= @owner.email %></p>
<p>Phone: <%= @owner.phone %></p>
<p>Address: <%= @owner.address %></p>

<h2>Pets</h2>

<ul>
  <% @owner.pets.each do |pet| %>
    <li>
      <%= link_to pet.name, pet_path(pet) %>
    </li>
  <% end %>
</ul>

<div class="d-flex gap-2 mt-3">
  <% if policy(Owner).index? %>
    <%= link_to "Back", owners_path, class: "btn btn-secondary" %>
  <% else %>
    <%= link_to "Back", root_path, class: "btn btn-secondary" %>
  <% end %>

  <% if policy(@owner).edit? %>
    <%= link_to "Edit", edit_owner_path(@owner), class: "btn btn-secondary" %>
  <% end %>

  <% if policy(@owner).destroy? %>
    <%= button_to "Delete",
        @owner,
        method: :delete,
        form: { data: { turbo_confirm: "Are you sure?" } },
        class: "btn btn-danger" %>
  <% end %>
</div>